<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_pilotage</name>
  <version>0.1.0</version>
  <description>Pilotage du G1 depuis l'Atelier, dans le conteneur du Jetson : petite API HTTP et WebSocket, postures, marche au joystick avec homme mort, gestes, voix, LED, danses du robot et chorégraphies sûres, verrou des mouvements avec le guide (Atelier G1, section 11.5 du plan)</description>
  <maintainer email="joonhk913@gmail.com">joonho</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>unitree_api</depend>
  <depend>unitree_hg</depend>
  <!-- API HTTP et WebSocket du nœud (dans le conteneur : python3-tornado) -->
  <exec_depend>python3-tornado</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <!-- Faux robot des tests de l'API (g1_jumeau.robot), s'il est là -->
  <test_depend>g1_jumeau</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
