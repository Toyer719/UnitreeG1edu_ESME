// Les repères (TF) du robot (chapitre 4)
digraph reperes_tf {
  graph [fontname="DejaVu Sans", fontsize=10.5, rankdir=TB, nodesep=0.4, ranksep=0.42];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#E3ECF7", color="#2F5597", margin="0.12,0.06"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#4A4A4A", arrowsize=0.7];

  map [label="map\nle repère de la carte de l'étage\n(fixe ; salles, itinéraires, zones)"];
  odom [label="odom\nrepère de l'odométrie : continu,\nsans saut, mais il dérive"];
  base [label="base_link\nle robot, au sol, x vers l'avant"];
  lidar [label="lidar\nle capteur MID-360, 1,245 m\nau-dessus du sol"];
  unitree [label="carte_unitree\norigine de la carte d'Unitree\n(= départ du scan)", fillcolor="#FDEBD9", color="#C55A11"];

  map -> odom [label="  simulation : identité fixe\n  robot : correction du repérage\n  (odom_vers_tf, 20 Hz)"];
  odom -> base [label="  simulation : Gazebo\n  robot : /state_estimator/odom_pelvis\n  relayé par odom_vers_tf"];
  base -> lidar [label="  fixe (robot_state_publisher\n  ou TF statique)"];
  map -> unitree [label=" fixe : repere_unitree\n (pour RViz)", style=dashed];
}
