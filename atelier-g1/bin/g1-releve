#!/usr/bin/env bash
# Relève les informations du robot dans un fichier que Claude peut lire : version du G1,
# ce que le robot publie, LiDAR, versions du Jetson. Robot allumé et câble Ethernet branché.
set -o pipefail   # pas de -u : les scripts de ROS 2 ne le supportent pas

source "$HOME/robot-g1/setup/env.sh"
DOSSIER="$HOME/robot-g1/docs/releves"
mkdir -p "$DOSSIER"
FICHIER="$DOSSIER/releve_$(date +%Y-%m-%d_%Hh%M).txt"
JETSON=192.168.123.164
LIDAR=192.168.123.120

{
  echo "=== Relevé du robot, $(date '+%d/%m/%Y %H:%M')"
  echo; echo "=== Connexion du PC au robot"
  if ! source "$HOME/robot-g1/setup/robot.sh"; then
    echo "Arrêt : branchez le câble, attendez la fin du démarrage du robot, puis relancez g1-releve."
    exit 1
  fi
  echo; echo "=== Le Jetson répond-il ($JETSON) ?"
  ping -c 3 -W 1 "$JETSON" | tail -2
  echo; echo "=== Le LiDAR répond-il ($LIDAR) ?"
  ping -c 3 -W 1 "$LIDAR" | tail -2
  echo; echo "=== État du robot"
  g1-etat --une-fois
  echo; echo "=== Ce que le robot publie (ros2 topic list, 8 s d'écoute)"
  ros2 topic list --no-daemon --spin-time 8 -t
} 2>&1 | tee "$FICHIER"
[ "${PIPESTATUS[0]}" -eq 0 ] || { rm -f "$FICHIER"; exit 1; }   # pas de relevé incomplet

echo
echo "=== Versions du Jetson : tapez le mot de passe du Jetson (les caractères ne s'affichent pas, c'est normal)"
ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "unitree@$JETSON" \
  'head -4 /etc/os-release; echo "ROS installés : $(ls /opt/ros 2>/dev/null)"; head -1 /etc/nv_tegra_release;
   echo "Docker : $(docker --version 2>/dev/null || echo absent)"; df -h / | tail -1; free -h | head -2' \
  2>&1 | { echo; echo "=== Versions du Jetson"; cat; } | tee -a "$FICHIER"

echo
echo "Relevé enregistré dans $FICHIER"
echo "Dites à Claude « relevé fait » : il lit ce fichier lui-même."
