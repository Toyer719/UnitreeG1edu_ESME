#!/usr/bin/env bash
# Banc de test du guide : N trajets entre salles tirées au sort, résultats en CSV.
#   g1-banc --lieu L --etage E --trajets 50 [--simu] [--lancer] [--graine N] [--seuil 90]
# La navigation doit tourner (g1-guide navigation ...), ou --lancer la démarre avec Gazebo.
# Pas de set -u : les scripts de ROS 2 ne le supportent pas.
RACINE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$HOME/robot-g1/setup/env.sh"
# g1_nav et g1_sim compilés avec les autres paquets (ws/install), sinon dans leurs dossiers
[ -d "$RACINE/ws/install/g1_nav" ] || source "$RACINE/ws/install_g1_nav/local_setup.bash"
if [ ! -d "$RACINE/ws/install/g1_sim" ] && [ -f "$RACINE/ws/install_g1_sim/local_setup.bash" ]; then
  source "$RACINE/ws/install_g1_sim/local_setup.bash"
fi
export PYTHONPATH="$RACINE${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m g1_nav.banc "$@"
