#!/usr/bin/env bash
# Nuage 3D cartes/<etage>.pcd → carte 2D de navigation cartes/<etage>.pgm + .yaml :
#   g1-carte-2d --lieu L --etage E
# Pas de set -u : les scripts de ROS 2 ne le supportent pas.
RACINE="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
source "$HOME/robot-g1/setup/env.sh"
PY="$RACINE/.venv-projet/bin/python"
[ -x "$PY" ] || PY="$HOME/robot-g1/.venv-projet/bin/python"
export PYTHONPATH="$RACINE${PYTHONPATH:+:$PYTHONPATH}"
exec "$PY" -m atelier.scan.commande carte-2d "$@"
