<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_jumeau</name>
  <version>0.1.0</version>
  <description>Faux G1 pour la répétition dans Gazebo : faux service sport (7105), vitesses du robot proxy, odométrie /state_estimator/odom_pelvis qui dérive (Atelier G1, section 10.4 du plan)</description>
  <maintainer email="joonhk913@gmail.com">joonho</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>unitree_api</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <!-- Essais de bout en bout dans Gazebo : simulation de g1_sim (jumeau:=true) et pont -->
  <test_depend>g1_bridge</test_depend>
  <test_depend>g1_sim</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
