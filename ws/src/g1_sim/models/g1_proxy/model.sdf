<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="g1_proxy">
    <!-- base_link est le seul maillon : le pied de la boîte est à l'origine du modèle -->
    <link name="base_link">
      <!-- 35 kg, centre de masse bas (0,4 m) pour que la boîte ne bascule pas -->
      <inertial>
        <pose>0 0 0.4 0 0 0</pose>
        <mass>35.0</mass>
        <inertia>
          <ixx>5.19</ixx>
          <iyy>5.52</iyy>
          <izz>0.85</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <!-- Boîte de 0,45 m (avant) × 0,30 m (côté) × 1,30 m (hauteur), posée au sol -->
      <collision name="corps">
        <pose>0.012 0.000 0.658 0 0 0</pose>
        <geometry>
          <box>
            <size>0.208 0.477 1.315</size>
          </box>
        </geometry>
        <surface>
          <!-- Frottement faible : la vitesse est imposée, le sol ne doit pas la freiner -->
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="g1_pelvis">
        <pose>0.00000 0.00000 0.78461 0.00000 -0.00000 0.00000</pose>
        <geometry>
          <mesh>
            <uri>meshes/pelvis.STL</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.78 0.78 0.80 1</ambient>
          <diffuse>0.78 0.78 0.80 1</diffuse>
        </material>
        <visibility_flags>2</visibility_flags>
