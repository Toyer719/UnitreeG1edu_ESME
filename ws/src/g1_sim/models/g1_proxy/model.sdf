      </visual>
      <!-- Le corps n'est pas visible pour son propre LiDAR (masque de visibilité 0x2) -->
      <!-- Petit repère blanc à l'avant, pour voir le cap du robot -->
      <!-- LiDAR à 1,2 m : 360 points sur 360° et 16 lignes de −7° à +52°, comme le MID-360 -->
      <sensor name="lidar" type="gpu_lidar">
        <pose>-0.004 0.000 1.245 0 0 0</pose>
        <topic>/model/g1_proxy/lidar</topic>
        <ignition_frame_id>lidar</ignition_frame_id>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265</min_angle>
              <max_angle>3.12413936</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples>
              <resolution>1</resolution>
              <min_angle>-0.12217305</min_angle>
              <max_angle>0.90757121</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.1</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
          <!-- Ne voit que ce qui n'a pas le drapeau 0x2 : tout sauf le robot lui-même -->
          <visibility_mask>4294967293</visibility_mask>
        </lidar>
      </sensor>
    </link>
    <!-- Suit /model/g1_proxy/cmd_vel : vx et vy dans le repère du robot, wz autour de z -->
    <plugin filename="ignition-gazebo-velocity-control-system" name="ignition::gazebo::systems::VelocityControl">
      <topic>/model/g1_proxy/cmd_vel</topic>
    </plugin>
    <!-- Odométrie parfaite dans le plan (x, y, cap) : odom → base_link, 50 Hz -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>2</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/model/g1_proxy/odometry</odom_topic>
      <tf_topic>/model/g1_proxy/tf</tf_topic>
    </plugin>
  </model>
</sdf>