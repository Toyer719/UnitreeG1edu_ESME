{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "seance.json",
  "description": "Manifeste d'une séance de la boîte noire (vague 6, section 13.3 du plan) : journaux/seances/<id>/seance.json, réécrit de façon atomique à chaque changement. Des champs en plus sont permis.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "version",
    "id",
    "etat",
    "mode",
    "debut",
    "fin",
    "ouverture",
    "fermeture",
    "enregistrement",
    "actions",
    "rapport"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "description": "AAAA-MM-JJ_HHhMM, avec un suffixe -2, -3… si la minute est déjà prise.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}_[0-9]{2}h[0-9]{2}(-[0-9]{1,3})?$"
    },
    "etat": {
      "description": "ouverte, fermee (Terminer la séance, arrêt de l'Atelier) ou interrompue (l'Atelier s'est arrêté sans la fermer : retrouvée au démarrage suivant).",
      "enum": [
        "ouverte",
        "fermee",
        "interrompue"
      ]
    },
    "mode": {
      "enum": [
        "reel",
        "repetition"
      ]
    },
    "lieu": {
      "anyOf": [
        {
          "description": "Identifiant : lettres minuscules sans accent, chiffres, _ et -, 40 caractères au plus.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "etage": {
      "anyOf": [
        {
          "description": "Identifiant : lettres minuscules sans accent, chiffres, _ et -, 40 caractères au plus.",
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "debut": {
      "description": "Date et heure ISO 8601 à l'heure locale, à la seconde, avec le décalage : 2026-11-12T14:03:05+01:00.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
    },
    "fin": {
      "anyOf": [
        {
          "description": "Date et heure ISO 8601 à l'heure locale, à la seconde, avec le décalage : 2026-11-12T14:03:05+01:00.",
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "duree_s": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "ouverture": {
      "description": "auto (espace de travail ouvert en Réel), manuel (bouton), g1-seance.",
      "enum": [
        "auto",
        "manuel",
        "g1-seance"
      ]
    },
    "fermeture": {
      "description": "Pourquoi elle s'est fermée, ou null tant qu'elle est ouverte.",
      "enum": [
        "terminer",
        "arret_atelier",
        "g1-seance",
        "plantage",
        null
      ]
    },
    "atelier": {
      "description": "Facultatif : l'Atelier qui l'a ouverte.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "string"
        },
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 0
        },
        "port": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "enregistrement": {
      "description": "L'enregistrement ROS 2 (bag/).",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "etat": {
          "description": "demarrage, en_cours, arrete (fermeture normale), coupe (taille maximale ou place libre trop faible : arrêt propre), absent (pas de ROS 2), erreur.",
          "enum": [
            "demarrage",
            "en_cours",
            "arrete",
            "coupe",
            "absent",
            "erreur"
          ]
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "octets": {
          "type": "integer",
          "minimum": 0
        },
        "sujets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "description": "Nom complet d'un sujet ROS 2.",
            "type": "string",
            "pattern": "^(/[A-Za-z_][A-Za-z0-9_]*)+$"
          }
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        }
      },
      "required": [
        "etat",
        "octets"
      ]
    },
    "actions": {
      "description": "Nombre de lignes de actions.jsonl.",
      "type": "integer",
      "minimum": 0
    },
    "diagnostic_debut": {
      "description": "Fichier du diagnostic de l'ouverture, ou null.",
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100
    },
    "jetson": {
      "description": "Journaux du conteneur du Jetson récupérés (avant chaque g1-jetson arreter lancé par l'Atelier, et à la fin).",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fichier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "t": {
            "description": "Date et heure ISO 8601 à l'heure locale, à la seconde, avec le décalage : 2026-11-12T14:03:05+01:00.",
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
          },
          "raison": {
            "enum": [
              "avant_arret",
              "fin",
              "manuel"
            ]
          },
          "octets": {
            "type": "integer",
            "minimum": 0
          },
          "ok": {
            "type": "boolean"
          },
          "message": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 300
          }
        },
        "required": [
          "fichier",
          "t",
          "raison",
          "ok"
        ]
      }
    },
    "rapport": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "etat": {
          "enum": [
            "absent",
            "en_cours",
            "pret",
            "echec"
          ]
        },
        "fichiers": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "message": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 300
        },
        "date": {
          "anyOf": [
            {
              "description": "Date et heure ISO 8601 à l'heure locale, à la seconde, avec le décalage : 2026-11-12T14:03:05+01:00.",
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[+-][0-9]{2}:[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "etat"
      ]
    },
    "reglages": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "taille_max_mo": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "place_libre_min_go": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "messages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 300
      }
    }
  }
}
