+++ b/legged_gym/envs/g1/g1_stairs_config.py
@@ -0,0 +1,125 @@
+"""G1 (12 DDL, jambes) — entraînement à la montée / descente d'escaliers. LE PROJET.
+
+Principe : politique "aveugle" pour l'acteur (mêmes 47 observations que la tâche
+"g1" d'origine -> compatible avec deploy_mujoco et le déploiement réel), mais le
+critique reçoit en plus une carte de hauteur du terrain (observation privilégiée,
+utilisée uniquement pendant l'entraînement).
+
+Lancement :  python legged_gym/scripts/train.py --task=g1_stairs --headless
+"""
+from legged_gym.envs.g1.g1_config import G1RoughCfg, G1RoughCfgPPO
+
+# Grille de points de la carte de hauteur (repère du robot, en mètres)
+_HEIGHT_X = [round(-0.5 + 0.1 * i, 2) for i in range(15)]   # -0.5 .. 0.9 (plus de points devant)
+_HEIGHT_Y = [round(-0.4 + 0.1 * i, 2) for i in range(9)]    # -0.4 .. 0.4
+_NUM_HEIGHT_POINTS = len(_HEIGHT_X) * len(_HEIGHT_Y)         # 135
+
+
+class G1StairsCfg(G1RoughCfg):
+
+    class env(G1RoughCfg.env):
+        num_envs = 4096
+        num_observations = 47                              # acteur : inchangé
+        num_privileged_obs = 50 + _NUM_HEIGHT_POINTS       # critique : + carte de hauteur
+        num_actions = 12
+        episode_length_s = 20
+
+    class terrain(G1RoughCfg.terrain):
+        mesh_type = 'trimesh'
+        horizontal_scale = 0.05      # 5 cm : nécessaire pour des marches de 20 cm de profondeur
+        vertical_scale = 0.005
+        border_size = 5.             # [m]
+        curriculum = True
+        static_friction = 1.0
+        dynamic_friction = 1.0
+        restitution = 0.
+        measure_heights = True       # sert aux récompenses + au critique (pas à l'acteur)
+        measured_points_x = _HEIGHT_X
+        measured_points_y = _HEIGHT_Y
+        max_init_terrain_level = 3
+        terrain_length = 8.
+        terrain_width = 8.
+        num_rows = 10                # niveaux de difficulté
+        num_cols = 20                # types de terrain
+        # [pente douce, pente rugueuse, escaliers montants, escaliers descendants, obstacles]
+        terrain_proportions = [0.1, 0.1, 0.4, 0.3, 0.1]
+        slope_treshold = 0.75
+        # paramètres spécifiques aux escaliers (StairsTerrain)
+        step_height_range = [0.03, 0.20]   # [m] difficulté 0 -> 1 (décor Unitree : 0.15)
+        step_width_range = [0.20, 0.35]    # [m] profondeur des marches (décor Unitree : 0.20)
+        platform_size = 2.5                # [m] zone plate au centre où le robot apparaît
+
+    class commands(G1RoughCfg.commands):
+        curriculum = False
+        num_commands = 4
+        resampling_time = 10.
+        heading_command = True
+        class ranges:
+            lin_vel_x = [-0.6, 1.0]    # [m/s] plus prudent que la marche sur sol plat
+            lin_vel_y = [-0.4, 0.4]
+            ang_vel_yaw = [-1.0, 1.0]
+            heading = [-3.14, 3.14]
+
+    class domain_rand(G1RoughCfg.domain_rand):
+        randomize_friction = True
+        friction_range = [0.3, 1.25]
+        randomize_base_mass = True
+        added_mass_range = [-1., 3.]
+        push_robots = True
+        push_interval_s = 8
+        max_push_vel_xy = 1.0
+
+    class asset(G1RoughCfg.asset):
+        penalize_contacts_on = ["hip", "knee"]
+        terminate_after_contacts_on = ["pelvis"]
+
+    class rewards(G1RoughCfg.rewards):
+        soft_dof_pos_limit = 0.9
+        base_height_target = 0.78         # mesurée par rapport au terrain sous le robot
+        feet_swing_height_target = 0.10   # hauteur du pied au-dessus du terrain sous lui [m]
+
+        class scales(G1RoughCfg.rewards.scales):
+            tracking_lin_vel = 1.0
+            tracking_ang_vel = 0.5
+            lin_vel_z = -0.5           # moins pénalisé : monter des marches fait bouger le bassin en z
+            ang_vel_xy = -0.05
+            orientation = -1.0
+            base_height = -10.0
+            dof_acc = -2.5e-7
+            dof_vel = -1e-3
+            feet_air_time = 0.0
+            collision = -1.0           # genoux / hanches qui tapent le nez des marches
+            stumble = -0.5             # pied qui bute contre la contremarche
+            action_rate = -0.01
+            dof_pos_limits = -5.0
+            alive = 0.15
+            hip_pos = -1.0
+            contact_no_vel = -0.2
+            feet_swing_height = -20.0
+            contact = 0.18
+
+    class viewer(G1RoughCfg.viewer):
+        pos = [-3, -3, 4]
+        lookat = [4., 4., 0.]
+
+
+class G1StairsCfgPPO(G1RoughCfgPPO):
+
+    class policy(G1RoughCfgPPO.policy):
+        init_noise_std = 0.8
+        actor_hidden_dims = [64]
+        critic_hidden_dims = [256, 128]
+        activation = 'elu'
+        rnn_type = 'lstm'
+        rnn_hidden_size = 64
+        rnn_num_layers = 1
+
+    class algorithm(G1RoughCfgPPO.algorithm):
+        entropy_coef = 0.01
+
+    class runner(G1RoughCfgPPO.runner):
+        policy_class_name = "ActorCriticRecurrent"
+        max_iterations = 15000
+        save_interval = 500
+        run_name = ''
+        experiment_name = 'g1_stairs'
