@@ -0,0 +1,29 @@
+"""LE PROJET — évaluation SANS affichage d'une politique G1 sur l'escalier du décor Unitree.
+
+Usage (depuis unitree_rl_gym) :
+  python3 deploy/deploy_mujoco/eval_stairs.py                      # politique de configs/g1_stairs.yaml
+  python3 deploy/deploy_mujoco/eval_stairs.py chemin/policy_lstm_1.pt
+Escalier : 10 marches de 15 cm (hauteur totale 1.5 m), 1re marche à x = 1.1 m.
+"""
+import sys, os, numpy as np, torch, mujoco, yaml
+R=os.path.abspath(os.path.join(os.path.dirname(__file__), '..', '..'))
+cfg=yaml.safe_load(open(R+'/deploy/deploy_mujoco/configs/g1_stairs.yaml'))
+policy_file=sys.argv[1] if len(sys.argv)>1 else cfg['policy_path'].replace('{LEGGED_GYM_ROOT_DIR}', R)
+m=mujoco.MjModel.from_xml_path(R+'/resources/robots/g1_description/scene_stairs.xml'); d=mujoco.MjData(m)
+m.opt.timestep=cfg['simulation_dt']; pol=torch.jit.load(policy_file)
+kp=np.array(cfg['kps']);kd=np.array(cfg['kds']);da=np.array(cfg['default_angles']);cmd=np.array(cfg['cmd_init'],dtype=np.float32)
+act=np.zeros(12,dtype=np.float32);tgt=da.copy();obs=np.zeros(47,dtype=np.float32)
+def grav(q):
+    w,x,y,z=q; return np.array([2*(-z*x+w*y),-2*(z*y+w*x),1-2*(w*w+z*z)])
+maxz=0
+for c in range(1,int(15/cfg['simulation_dt'])+1):
+    d.ctrl[:]=(tgt-d.qpos[7:])*kp-d.qvel[6:]*kd; mujoco.mj_step(m,d)
+    if c%cfg['control_decimation']==0:
+        ph=(c*cfg['simulation_dt'])%0.8/0.8
+        obs[:3]=d.qvel[3:6]*0.25;obs[3:6]=grav(d.qpos[3:7]);obs[6:9]=cmd*np.array(cfg['cmd_scale'])
+        obs[9:21]=d.qpos[7:]-da;obs[21:33]=d.qvel[6:]*0.05;obs[33:45]=act;obs[45:47]=[np.sin(2*np.pi*ph),np.cos(2*np.pi*ph)]
+        act=pol(torch.from_numpy(obs).unsqueeze(0)).detach().numpy().squeeze();tgt=act*0.25+da
+    maxz=max(maxz,d.qpos[2]-0.78)
+    if d.qpos[2]<0.4+max(0,maxz): print(f"CHUTE à t={c*cfg['simulation_dt']:.1f}s, x={d.qpos[0]:.2f} m"); sys.stdout.flush(); break
+print(f"fin (15 s) : x={d.qpos[0]:.2f} m, montée max du bassin ≈ {maxz*100:.0f} cm (haut de l'escalier ≈ 150 cm)")
+sys.stdout.flush(); import os; os._exit(0)
