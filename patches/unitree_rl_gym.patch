@@ -0,0 +1,55 @@
+"""Terrain orienté escaliers pour l'entraînement du G1 (LE PROJET).
+
+Reprend la classe Terrain d'origine, mais :
+  - la majorité des sous-terrains sont des escaliers (montée / descente),
+  - la profondeur des marches varie (0.20 m à 0.35 m) pour couvrir les marches
+    étroites du décor Unitree (0.20 m de profondeur, 0.15 m de hauteur),
+  - la hauteur des marches suit le curriculum : difficulty 0 -> 3 cm, 1 -> 20 cm.
+
+Colonnes (types) avec les proportions par défaut de G1StairsCfg :
+  [pente douce, pente rugueuse, escaliers montants, escaliers descendants, obstacles]
+Lignes (niveaux) : difficulté croissante.
+"""
+import numpy as np
+from isaacgym import terrain_utils
+
+from legged_gym.utils.terrain import Terrain
+
+
+class StairsTerrain(Terrain):
+
+    def make_terrain(self, choice, difficulty):
+        terrain = terrain_utils.SubTerrain("terrain",
+                                           width=self.width_per_env_pixels,
+                                           length=self.width_per_env_pixels,
+                                           vertical_scale=self.cfg.vertical_scale,
+                                           horizontal_scale=self.cfg.horizontal_scale)
+        min_h, max_h = self.cfg.step_height_range
+        step_height = min_h + (max_h - min_h) * difficulty
+        step_width = np.random.uniform(*self.cfg.step_width_range)
+        slope = difficulty * 0.3
+        obstacle_height = 0.03 + difficulty * 0.12
+        platform = self.cfg.platform_size
+
+        if choice < self.proportions[0]:
+            # pente lisse (montante ou descendante)
+            if choice < self.proportions[0] / 2:
+                slope *= -1
+            terrain_utils.pyramid_sloped_terrain(terrain, slope=slope, platform_size=platform)
+        elif choice < self.proportions[1]:
+            # pente + petites irrégularités
+            terrain_utils.pyramid_sloped_terrain(terrain, slope=slope, platform_size=platform)
+            terrain_utils.random_uniform_terrain(terrain, min_height=-0.03, max_height=0.03,
+                                                 step=0.005, downsampled_scale=0.2)
+        elif choice < self.proportions[3]:
+            # escaliers. Hauteur négative = le centre est en creux -> le robot,
+            # qui démarre au centre, MONTE en s'éloignant. Positive = il descend.
+            if choice < self.proportions[2]:
+                step_height *= -1
+            terrain_utils.pyramid_stairs_terrain(terrain, step_width=step_width,
+                                                 step_height=step_height, platform_size=platform)
+        else:
+            # blocs rectangulaires dispersés
+            terrain_utils.discrete_obstacles_terrain(terrain, obstacle_height, 1., 2., 20,
+                                                     platform_size=platform)
+        return terrain
