+    # ------------------------------------------------------------------
+    # LE PROJET : télécommande virtuelle (~/unitree/virtual_remote)
+    # La fenêtre publie un WirelessController_ sur un topic dédié ; on le
+    # recopie dans lowstate.wireless_remote avec le même format qu'une vraie
+    # télécommande Unitree. Sécurité : sans message depuis
+    # VIRTUAL_REMOTE_TIMEOUT s, sticks et boutons retombent à zéro.
+    # ------------------------------------------------------------------
+    VIRTUAL_REMOTE_TIMEOUT = 0.3
+
+    def SetupVirtualRemote(self, topic):
+        self.virtual_remote = {"msg": None, "stamp": 0.0, "lock": threading.Lock(), "active": False}
+        self.virtual_remote_suber = ChannelSubscriber(topic, WirelessController_)
+        self.virtual_remote_suber.Init(self._VirtualRemoteHandler, 10)
+        print(f"Télécommande virtuelle : écoute du topic '{topic}'")
+
+    def _VirtualRemoteHandler(self, msg: WirelessController_):
+        vr = self.virtual_remote
+        with vr["lock"]:
+            vr["msg"] = msg
+            vr["stamp"] = time.monotonic()
+        if not vr["active"]:
+            vr["active"] = True
+            print("Télécommande virtuelle : connectée")
+
+    def _VirtualRemoteState(self):
+        vr = self.virtual_remote
+        with vr["lock"]:
+            msg, stamp = vr["msg"], vr["stamp"]
+        if msg is None or time.monotonic() - stamp > self.VIRTUAL_REMOTE_TIMEOUT:
+            if vr["active"]:
+                vr["active"] = False
+                print("Télécommande virtuelle : plus de signal -> sticks et boutons à zéro")
+            return 0, 0.0, 0.0, 0.0, 0.0
+        return int(msg.keys) & 0xFFFF, float(msg.lx), float(msg.ly), float(msg.rx), float(msg.ry)
+
+    def _FillWirelessRemoteFromVirtual(self):
+        keys, lx, ly, rx, ry = self._VirtualRemoteState()
+        wr = self.low_state.wireless_remote
+        wr[2] = keys & 0xFF          # R1 L1 start select R2 L2 F1 F2
+        wr[3] = (keys >> 8) & 0xFF   # A B X Y up right down left
+        wr[4:8] = struct.pack("f", lx)
+        wr[8:12] = struct.pack("f", rx)
+        wr[12:16] = struct.pack("f", ry)
+        wr[20:24] = struct.pack("f", ly)
+
     def SetupJoystick(self, device_id=0, js_type="xbox"):
         pygame.init()
         pygame.joystick.init()
