// Le repérage au démarrage (chapitre 8)
digraph reperage {
  graph [fontname="DejaVu Sans", fontsize=10.5, rankdir=TB, nodesep=0.6, ranksep=0.26, newrank=true, splines=line];
  node  [fontname="DejaVu Sans", fontsize=10, shape=box, style="rounded,filled", fillcolor="#E3ECF7", color="#2F5597", margin="0.10,0.05", width=2.7];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#4A4A4A", arrowsize=0.7];

  subgraph cluster_a {
    label="1. La demande"; style="rounded"; color="#2F5597"; fontcolor="#1F3A5F";
    pose [label="Robot posé sur le point\nprincipal ★, dans le sens\nde sa flèche", fillcolor="#FFF6D5", color="#BF9000"];
    bouton [label="Naviguer › Repérer\nPOST /api/robot/reperer"];
    demande [label="/reperage/demander\nx, y, theta du point principal", style="filled", fillcolor="#F2F2F2", color="#7F7F7F"];
    relais [label="odom_vers_tf (reperage.py) :\npose convertie dans le\nrepère de la carte d'Unitree"];
    ordre [label="ordre 1804 sur\n/api/slam_operate/request", style="filled", fillcolor="#F2F2F2", color="#7F7F7F"];
  }
  subgraph cluster_b {
    label="2. La réponse du robot"; style="rounded"; color="#C55A11"; fontcolor="#843C0C";
    slam [label="SLAM d'Unitree (PC1) :\nse repère sur sa carte .pcd", fillcolor="#FDEBD9", color="#C55A11"];
    reloc [label="/unitree/slam_relocation/odom\n+ /state_estimator/odom_pelvis", style="filled", fillcolor="#F2F2F2", color="#7F7F7F"];
    controle [label="contrôle : à moins de 1 m\net 0,5 rad de la pose annoncée ?"];
    ok [label="oui : TF map → odom,\nétat « repere » ;\nle pont permet\nle mouvement", fillcolor="#E2F0D9", color="#548235", width=1.9];
    echec [label="non : « echec » avec\nun message qui dit quoi faire", fillcolor="#FBE3E1", color="#C0392B"];
  }
  pose -> bouton -> demande -> relais -> ordre;
  slam -> reloc -> controle;
  controle -> ok [xlabel="oui ", fontcolor="#548235"];
  controle:e -> echec:e [xlabel="non ", fontcolor="#C0392B"];
  ok -> echec [style=invis];
  ordre:e -> slam:w [constraint=false];
  {rank=same; pose; slam}
}
